---
/*
 * Stands in for src/layouts/Layout.astro in page tests: renders the page
 * body after a <template> that records the title, description and
 * previewDescription props the page passed, because Layout.astro's head
 * builds absolute URLs from Astro.site, which the Astro Container API leaves
 * unset.
 */
const { title, description, previewDescription } = Astro.props;
---

<template
  data-title={title}
  data-description={description}
  data-preview-description={previewDescription}
></template>
<slot />
