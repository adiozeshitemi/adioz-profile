---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Adioz | Full-stack AI engineer",
  description = "Full-stack AI engineer who takes AI into production for enterprise clients: tool-using agents that make auditable changes, and small, quantized models that meet tight latency budgets.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://adioz.dev" />
  </head>
  <body class="min-h-screen flex flex-col justify-between">
    <slot />
  </body>
</html>
