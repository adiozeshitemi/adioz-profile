---
import "../styles/global.css";
import EngravingFilters from "../components/UI/EngravingFilters.astro";
import ParticleField from "../components/UI/ParticleField.astro";
import { profile, site } from "../data/index";
import themeInit from "../scripts/theme-init.js?raw";

interface Props {
  /** Page title; defaults to "<name> | <role>" from profile.json. */
  title?: string;
  /** Meta and Open Graph description; defaults to site.json. */
  description?: string;
  /** Open Graph image path under public/; defaults to site.json. */
  image?: string;
  /** Alt text for the Open Graph image; defaults to site.json. */
  imageAlt?: string;
  /** Draws the particle field behind the page; off by default. */
  field?: boolean;
}

const {
  title = `${profile.name} | ${profile.role}`,
  description = site.description,
  image = site.image,
  imageAlt = site.imageAlt,
  field = false,
} = Astro.props;

// Absolute URLs from `site` in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <!--
      theme-color values match --bg for each theme in theme.css;
      data-theme-color names the theme each belongs to, for the theme scripts.
    -->
    <meta
      name="theme-color"
      content="#eceef2"
      media="(prefers-color-scheme: light)"
      data-theme-color="light"
    />
    <meta
      name="theme-color"
      content="#08090b"
      media="(prefers-color-scheme: dark)"
      data-theme-color="dark"
    />
    <link
      rel="preload"
      href="/fonts/montserrat-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={themeInit} />
  </head>
  <body class="min-h-screen flex flex-col">
    <EngravingFilters />
    {field && <ParticleField />}
    <slot />
    <script>
      import "../scripts/motion";
      import { lightEnabled, startLight } from "../scripts/light";
      import { startView } from "../scripts/view";

      // The pointer light and the view turn share one condition: a fine
      // pointer and no preference for reduced motion.
      if (lightEnabled()) {
        startLight();
        startView();
      }
    </script>
  </body>
</html>
