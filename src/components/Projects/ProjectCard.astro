---
/*
 * One projects.json project on a machined Panel that tilts toward the
 * pointer (data-tilt): its name carved into a screwed Nameplate, its links
 * as Ports, its description, its tags and its result line beside a lamp.
 * The description grows, so the tags and result lines of cards in a row
 * line up.
 */
import type { ProjectItem } from "../../data/types";
import Emphasis from "../UI/Emphasis.astro";
import Lamp from "../UI/Lamp.astro";
import Nameplate from "../UI/Nameplate.astro";
import Panel from "../UI/Panel.astro";
import Port from "../UI/Port.astro";
import Tag from "../UI/Tag.astro";

interface Props {
  project: ProjectItem;
}

const { project } = Astro.props;
---

<Panel as="article" class="project" data-tilt>
  <Nameplate name={project.title} class="project-plate" />
  <ul class="ports">
    {project.links.map((link) => (
      <li>
        <Port link={link} />
      </li>
    ))}
  </ul>
  <p class="desc">{project.description}</p>
  <ul class="tags">
    {project.tags.map((tag) => (
      <Tag as="li">{tag}</Tag>
    ))}
  </ul>
  <p class="metric">
    <Lamp />
    <span>
      <Emphasis text={project.metric} />
    </span>
  </p>
</Panel>

<style>
  .project {
    display: flex;
    flex-direction: column;
    will-change: transform;
  }

  :global(.panel).project {
    padding: 32px 32px 26px;
    border-radius: 28px;
  }

  .project :global(.project-plate) {
    align-self: flex-start;
  }

  .ports {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    margin: 26px 0 0;
    padding: 0;
    list-style: none;
  }

  .desc {
    flex: 1;
    max-width: 60ch;
    margin: 24px 0 0;
    color: var(--body);
    font-size: 16px;
    line-height: 1.65;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags :global(.tag) {
    font-size: 12px;
    letter-spacing: 0.02em;
  }

  /* The result line under a hairline, led by the gold status lamp centred on its first line. */
  .metric {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin: 22px 0 0;
    padding: 18px 0 0;
    border-top: 1px solid var(--line);
    color: var(--body);
    font-size: 14px;
    line-height: 1.5;
  }

  .metric :global(.lamp) {
    margin-top: calc(0.75em - 5px);
  }

  .metric :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  @media (width <= 40rem) {
    :global(.panel).project {
      padding: 26px 20px 22px;
    }
  }
</style>
