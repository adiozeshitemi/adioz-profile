---
/*
 * The phone menu, below 980px (61.25rem), where the header's rail is hidden:
 * a compact menu Knob that opens the menu sheet, an HTML popover. While
 * closed the sheet is not rendered, so keyboard and screen-reader users
 * cannot reach its links; Escape or a tap outside closes it, as does choosing
 * one of its links or the viewport widening to 980px. The knob is named for
 * what a press does (navigation.json's menuLabel) and reports the sheet's
 * state in aria-expanded.
 */
import { navigation, sectionNumber } from "../../data/index";
import Knob from "../UI/Knob.astro";

const links = [...navigation.links, navigation.cta].map((link) => ({
  ...link,
  number: String(sectionNumber(link.url.slice(1))).padStart(2, "0"),
}));
---

<Knob
  compact
  class="menu-toggle"
  label={navigation.menuLabel.open}
  popovertarget="site-menu"
  aria-controls="site-menu"
  aria-expanded="false"
  data-label-open={navigation.menuLabel.open}
  data-label-close={navigation.menuLabel.close}
>
  <svg
    class="menu-icon engraved-icon"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.4"
    stroke-linecap="round"
  >
    <path d="M5 7h14M5 12h14M5 17h14"></path>
  </svg>
</Knob>

<nav id="site-menu" class="menu-sheet" popover aria-label={navigation.label}>
  <ol>
    {links.map((link) => (
      <li>
        <a href={link.url}>
          <span class="menu-no" aria-hidden="true">
            {link.number}
          </span>
          {link.title}
        </a>
      </li>
    ))}
  </ol>
</nav>

<script>
  import { startMenu } from "../../scripts/menu";

  const sheet = document.getElementById("site-menu");
  const toggle = document.querySelector<HTMLElement>(".menu-toggle");
  if (sheet && toggle) startMenu(sheet, toggle);
</script>

<style>
  :global(.menu-toggle) .menu-icon {
    width: 16px;
    height: 16px;
  }

  /*
   * From 980px the header shows the rail of section links instead. The knob's
   * selector outranks Knob's own display: grid.
   */
  @media (width >= 61.25rem) {
    :global(.site-header .knob.menu-toggle),
    .menu-sheet {
      display: none;
    }
  }

  /*
   * The sheet: a brushed gunmetal case, dark in both themes, that drops from
   * under the header on a 6px wall. Each link is a row with its section number
   * engraved; the current section (aria-current) is gold.
   */
  .menu-sheet {
    inset: calc(var(--spacing-header) + 8px) 16px auto auto;
    width: min(340px, calc(100vw - 32px));
    margin: 0;
    padding: 8px;
    border: 0;
    border-radius: 18px;
    color: #c9cfd7;
    background-image:
      var(--brush-noise-soft), linear-gradient(190deg, #262b31, #14171b);
    background-size:
      320px 140px,
      100% 100%;
    background-blend-mode: overlay, normal;
    box-shadow:
      inset calc(var(--lean) * var(--slant) * 1px) 1px 0 rgb(255 255 255 / 0.14),
      0 0 0 1px rgb(0 0 0 / 0.6),
      calc(var(--lean) * var(--slant) * 2px) 2px 0 #3d4148,
      calc(var(--lean) * var(--slant) * 4px) 4px 0 #32353b,
      calc(var(--lean) * var(--slant) * 6px) 6px 0 #2b2e33,
      calc(var(--lean) * var(--slant) * 6px) 6px 0 1px rgb(0 0 0 / 0.6),
      calc(var(--lean) * var(--slant) * 24px) 30px 60px -16px rgb(0 0 0 / 0.7);
    opacity: 0;
    transform: translateY(-10px) scale(0.98);
    transform-origin: top right;
    transition:
      opacity 0.25s var(--ease-soft),
      transform 0.35s var(--ease-soft),
      overlay 0.35s allow-discrete,
      display 0.35s allow-discrete;
  }

  .menu-sheet:popover-open {
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .menu-sheet:popover-open {
      opacity: 0;
      transform: translateY(-10px) scale(0.98);
    }
  }

  .menu-sheet::backdrop {
    background: rgb(5 6 8 / 0.35);
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li + li {
    border-top: 1px solid rgb(0 0 0 / 0.55);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.05);
  }

  a {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 13px 14px;
    border-radius: 10px;
    color: #d6dce3;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s var(--ease-soft),
      color 0.2s var(--ease-soft);
  }

  a:hover,
  a:focus-visible {
    background-color: rgb(255 255 255 / 0.05);
  }

  a:focus-visible {
    outline: 2px solid #e6c062;
    outline-offset: -2px;
  }

  a[aria-current="true"] {
    color: #f2d27e;
  }

  /* The section number, cut into the gunmetal (.engraved's fill and lips). */
  .menu-no {
    min-width: 2ch;
    font-family: var(--font-mono);
    font-size: 12px;
    color: transparent;
    background-image: linear-gradient(
      180deg,
      #2a2f35 0%,
      #4a515a 38%,
      #a9b1bb 72%,
      #d6dce3 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 -1px 0 #000)
      drop-shadow(0 1px 0 rgb(255 255 255 / 0.3));
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-sheet,
    a {
      transition: none;
    }
  }
</style>
