---
import { navigation } from "../../data/index";
import BrandLogo from "./BrandLogo.astro";
import MobileMenu from "./MobileMenu.astro";
import NavLinks from "./NavLinks.astro";
---

<header class="site-header">
  <div class="inner">
    <BrandLogo />
    <nav class="links" aria-label={navigation.label}>
      <NavLinks />
    </nav>
    <MobileMenu />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 90;
    border-bottom: 1px solid var(--color-line);
    /* 85% canvas keeps ink-muted link text at 4.5:1 or more over any page content beneath. */
    background: color-mix(in srgb, var(--color-canvas) 85%, transparent);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    backdrop-filter: blur(18px) saturate(160%);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--container-page);
    height: var(--spacing-header);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .links {
    display: none;
  }

  /* --breakpoint-md: inline links replace the menu button. */
  @media (width >= 47.5rem) {
    .inner {
      padding-inline: 1.75rem;
    }

    .links {
      display: block;
    }
  }
</style>
