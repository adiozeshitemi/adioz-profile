---
/*
 * The theme knob: a compact Knob whose face shows the theme a press switches
 * to (the sun on the dark theme, the moon on the light one). Its accessible
 * name is the visible one of two labels, so it follows data-theme on <html>
 * with no script. Without JavaScript no theme is set and the knob is hidden.
 */
import Knob from "../UI/Knob.astro";
---

<Knob compact class="theme-toggle">
  <span class="icons">
    <svg
      class="sun engraved-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
    </svg>
    <svg
      class="moon engraved-icon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z"></path>
    </svg>
  </span>
  <span slot="label" class="label to-light">
    Switch to light theme
  </span>
  <span slot="label" class="label to-dark">
    Switch to dark theme
  </span>
</Knob>

<script>
  import { followDevice, toggleTheme } from "../../scripts/theme";

  followDevice();
  for (const button of document.querySelectorAll(".theme-toggle")) {
    button.addEventListener("click", toggleTheme);
  }
</script>

<style>
  :global(:root:not([data-theme])) :global(.theme-toggle) {
    display: none;
  }

  /* The accessible name: the label for the theme a press switches to. */
  .label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(:root[data-theme="light"]) .to-light,
  :global(:root[data-theme="dark"]) .to-dark {
    display: none;
  }

  /* The sun and moon share one spot and turn as they swap. */
  .icons {
    display: grid;
    place-items: center;
  }

  .icons svg {
    grid-area: 1 / 1;
    width: 16px;
    height: 16px;
    transition:
      opacity 0.35s var(--ease-soft),
      transform 0.5s var(--ease-soft),
      color 0.3s var(--ease-soft);
  }

  :global(:root[data-theme="dark"]) .moon,
  :global(:root[data-theme="light"]) .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .icons svg {
      transition: none;
    }
  }
</style>
