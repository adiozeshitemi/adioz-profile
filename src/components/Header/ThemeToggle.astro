---
/*
 * The theme knob: a compact steel knob whose face shows the theme a press
 * switches to (the sun on the dark theme, the moon on the light one). Its
 * accessible name is the visible one of two labels, so it follows data-theme
 * on <html> with no script. Without JavaScript no theme is set and the knob is
 * hidden.
 */
---

<button type="button" class="theme-toggle">
  <span class="label to-light">Switch to light theme</span>
  <span class="label to-dark">Switch to dark theme</span>
  <span class="face" aria-hidden="true">
    <svg
      class="sun"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
    >
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"></path>
    </svg>
    <svg
      class="moon"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z"></path>
    </svg>
  </span>
</button>

<script>
  import { followDevice, toggleTheme } from "../../scripts/theme";

  followDevice();
  for (const button of document.querySelectorAll(".theme-toggle")) {
    button.addEventListener("click", toggleTheme);
  }
</script>

<style>
  /*
   * A 36px steel bezel on a 3px wall slanted by --lean, around a spun face.
   * Hover lifts it 1px off the page; press sinks it 2px.
   */
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    flex: none;
    padding: 3px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(215deg, #ffffff, #9aa1aa 45%, #2f343a);
    box-shadow:
      0 0 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 1px) 1px 0 0 #8f969e,
      calc(var(--lean) * var(--slant) * 2px) 2px 0 0 #71787f,
      calc(var(--lean) * var(--slant) * 3px) 3px 0 0 #545a61,
      calc(var(--lean) * var(--slant) * 3px) 3px 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 5px) 5px 3px 0 var(--metal-contact),
      calc(var(--lean) * var(--slant) * 9px) 9px 16px -6px var(--metal-drop);
    transition:
      transform 0.25s var(--ease-soft),
      box-shadow 0.25s var(--ease-soft);
  }

  .theme-toggle:hover {
    transform: translate(calc(var(--lean) * var(--slant) * -1px), -1px);
    box-shadow:
      0 0 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 1px) 1px 0 0 #8f969e,
      calc(var(--lean) * var(--slant) * 2px) 2px 0 0 #71787f,
      calc(var(--lean) * var(--slant) * 3px) 3px 0 0 #545a61,
      calc(var(--lean) * var(--slant) * 3px) 3px 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 7px) 7px 6px -1px
        var(--metal-contact-lift),
      calc(var(--lean) * var(--slant) * 12px) 12px 20px -6px var(--metal-drop);
  }

  .theme-toggle:active {
    transform: translate(calc(var(--lean) * var(--slant) * 2px), 2px);
    box-shadow:
      0 0 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 1px) 1px 0 0 #8f969e,
      calc(var(--lean) * var(--slant) * 1px) 1px 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 2px) 2px 2px 0 var(--metal-contact),
      calc(var(--lean) * var(--slant) * 5px) 5px 10px -6px var(--metal-drop);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--gold-text);
    outline-offset: 3px;
  }

  :global(:root:not([data-theme])) .theme-toggle {
    display: none;
  }

  /* The accessible name: the label for the theme a press switches to. */
  .label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  :global(:root[data-theme="light"]) .to-light,
  :global(:root[data-theme="dark"]) .to-dark {
    display: none;
  }

  /*
   * The face: circularly brushed steel, fine rings over a two-fold light cross,
   * shaded at its rim, holding the sun and moon on one spot.
   */
  .face {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background:
      repeating-radial-gradient(
        circle at 50% 50%,
        rgb(255 255 255 / 0.1) 0 0.6px,
        rgb(0 0 0 / 0.08) 0.6px 1.3px,
        transparent 1.3px 2.1px
      ),
      conic-gradient(
        from 45deg,
        #f7f8fa 0deg,
        #c9ced4 24deg,
        #e8ebee 56deg,
        #6a7078 90deg,
        #c9ced4 124deg,
        #aeb4bb 156deg,
        #f7f8fa 180deg,
        #c9ced4 204deg,
        #e8ebee 236deg,
        #5a6068 270deg,
        #c9ced4 304deg,
        #aeb4bb 336deg,
        #f7f8fa 360deg
      );
    background-blend-mode: overlay, normal;
    box-shadow:
      0 0 0 1px rgb(20 24 30 / 0.55),
      inset 0 0 0 1px rgb(255 255 255 / 0.45),
      inset calc(var(--lean) * var(--slant) * 2px) 2px 2px
        rgb(255 255 255 / 0.3),
      inset calc(var(--lean) * var(--slant) * -2px) -2px 4px rgb(0 0 0 / 0.3);
    color: #1b1e23;
  }

  .face svg {
    grid-area: 1 / 1;
    width: 16px;
    height: 16px;
    transition:
      opacity 0.35s var(--ease-soft),
      transform 0.5s var(--ease-soft);
  }

  :global(:root[data-theme="dark"]) .moon,
  :global(:root[data-theme="light"]) .sun {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle,
    .face svg {
      transition: none;
    }
  }
</style>
