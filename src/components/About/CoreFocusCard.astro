---
import type { FocusPillar } from "../../data/types";
import Badge from "../UI/Badge.astro";
import Icon from "../UI/Icon.astro";

interface Props {
  /** One about.json pillar: its icon, title, description and tags. */
  pillar: FocusPillar;
}

const { pillar } = Astro.props;
---

<article class="card spot" data-reveal>
  <div class="icon">
    <Icon name={pillar.icon} size={20} />
  </div>
  <h3>{pillar.title}</h3>
  <p>{pillar.description}</p>
  <ul class="tags">
    {pillar.tags.map((tag) => (
      <li>
        <Badge>{tag}</Badge>
      </li>
    ))}
  </ul>
</article>

<style>
  .card {
    position: relative;
    overflow: hidden;
    padding: 1.875rem 1.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-card);
    transition:
      transform 0.4s var(--ease-soft),
      border-color 0.35s,
      background-color 0.35s;
  }

  .card:hover {
    transform: translateY(-5px);
    border-color: var(--color-line-strong);
    background: var(--color-card-hover);
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-bottom: 1.25rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 0.75rem;
    background: linear-gradient(
      140deg,
      color-mix(in srgb, var(--color-accent-cyan) 14%, transparent),
      color-mix(in srgb, var(--color-accent-violet) 10%, transparent)
    );
    color: var(--color-accent-cyan);
  }

  h3 {
    margin-bottom: 0.625rem;
    font-size: 1.06rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: var(--color-ink);
  }

  p {
    font-size: 0.925rem;
    line-height: 1.72;
    color: var(--color-ink-muted);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4375rem;
    margin-top: 1.125rem;
  }

  /* Card hover raises the tags to ink-muted text and line-strong borders. */
  .card:hover :global(.tag) {
    border-color: var(--color-line-strong);
    color: var(--color-ink-muted);
  }
</style>
