---
/*
 * One techStack.json skill as a <dt>/<dd> group for TechStackSection's <dl>:
 * the label, the level, and a bar filled to the skill's percent. The bar is
 * hidden from assistive technology, which reads the level instead.
 */
import type { SkillItem } from "../../data/types";

interface Props {
  skill: SkillItem;
}

const { skill } = Astro.props;
---

<div class="skill">
  <dt class="label">{skill.label}</dt>
  <dd class="level">{skill.level}</dd>
  <dd class="bar" aria-hidden="true">
    <span class="fill" style={`width: ${skill.percent}%`} data-fill></span>
  </dd>
</div>

<style>
  .skill {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 0.625rem 1rem;
  }

  .label {
    font-size: 0.925rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }

  .level {
    font-size: 0.71875rem;
    color: var(--color-ink-faint);
  }

  /* overflow: clip, unlike hidden, adds no scroll container, so the fill's data-fill view timeline tracks the viewport. */
  .bar {
    grid-column: 1 / -1;
    height: 4px;
    overflow: clip;
    border-radius: 99px;
    background: color-mix(in srgb, var(--color-ink) 6%, transparent);
  }

  .fill {
    display: block;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(
      90deg,
      var(--color-accent-cyan),
      var(--color-accent-violet)
    );
    box-shadow: 0 0 12px
      color-mix(in srgb, var(--color-accent-cyan) 50%, transparent);
  }
</style>
