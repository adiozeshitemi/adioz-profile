---
/*
 * The tech stack section from techStack.json: the gold headline and intro,
 * the gauge cluster (a Gauge per skill on one brushed Plate screwed down at
 * its corners), then a TagCloud per tool category.
 */
import { techStack } from "../../data/index";
import Plate from "../UI/Plate.astro";
import SectionTitle from "../UI/SectionTitle.astro";
import Gauge from "./Gauge.astro";
import TagCloud from "./TagCloud.astro";

const titleId = `${techStack.id}-title`;
---

<section id={techStack.id} class="stack" aria-labelledby={titleId}>
  <div class="inner">
    <SectionTitle
      section={techStack.id}
      label={techStack.label}
      title={techStack.headline}
      id={titleId}
    >
      <p>{techStack.intro}</p>
    </SectionTitle>
    <Plate class="cluster">
      <dl class="gauges">
        {techStack.skills.map((skill) => (
          <Gauge skill={skill} />
        ))}
      </dl>
    </Plate>
    <div class="categories">
      {techStack.categories.map((category) => (
        <TagCloud category={category} />
      ))}
    </div>
  </div>
</section>

<script>
  import { startGauges } from "../../scripts/gauges";

  const cluster = document.querySelector<HTMLElement>(".stack .cluster");
  if (cluster) startGauges(cluster);
</script>

<style>
  .stack {
    padding-block: clamp(84px, 10vw, 140px);
  }

  .inner {
    width: 100%;
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: 28px;
  }

  /* The cluster wraps its gauges into centred rows. */
  .inner :global(.plate.cluster) {
    margin: 0 0 22px;
    padding: 46px 28px 38px;
  }

  .gauges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 34px 18px;
    margin: 0;
  }

  .categories {
    display: grid;
    gap: 1.75rem;
    margin-top: 64px;
  }

  /* --breakpoint-md */
  @media (width >= 47.5rem) {
    .categories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (width <= 40rem) {
    .inner {
      padding-inline: 16px;
    }

    .inner :global(.plate.cluster) {
      padding: 46px 16px 34px;
    }
  }
</style>
