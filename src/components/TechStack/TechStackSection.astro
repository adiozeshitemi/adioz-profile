---
/*
 * The tech stack section from techStack.json: the gold headline and intro,
 * the kit: the gauge cluster (a Gauge per skill on one brushed Plate
 * screwed down at its corners) and a TagCloud per tool category.
 */
import { techStack } from "../../data/index";
import Plate from "../UI/Plate.astro";
import SectionTitle from "../UI/SectionTitle.astro";
import Gauge from "./Gauge.astro";
import TagCloud from "./TagCloud.astro";

const titleId = `${techStack.id}-title`;
---

<section id={techStack.id} class="stack" aria-labelledby={titleId}>
  <div class="inner">
    <SectionTitle
      section={techStack.id}
      label={techStack.label}
      title={techStack.headline}
      id={titleId}
    >
      <p>{techStack.intro}</p>
    </SectionTitle>
    <div class="kit">
      <Plate class="cluster">
        <dl class="gauges">
          {techStack.skills.map((skill) => (
            <Gauge skill={skill} />
          ))}
        </dl>
      </Plate>
      <div class="categories">
        {techStack.categories.map((category) => (
          <TagCloud category={category} />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  import { startGauges } from "../../scripts/gauges";

  const cluster = document.querySelector<HTMLElement>(".stack .cluster");
  if (cluster) startGauges(cluster);
</script>

<style>
  .stack {
    padding-block: clamp(84px, 10vw, 140px);
  }

  .inner {
    width: 100%;
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: 28px;
  }

  /*
   * Below 1000px the cluster sits above the categories, its gauges wrapping
   * into centred rows. From 1000px the kit sets the cluster beside them as a
   * 380px vertical strip, each gauge a row of its 128px dial and its label;
   * on screens at least 900px tall the strip stays in view below the header
   * while the longer category column scrolls. Up to 640px the gauges shrink
   * to 128px dials, two to a row.
   */
  .inner :global(.plate.cluster) {
    margin: 0 0 22px;
    padding: 46px 28px 38px;
  }

  .gauges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 34px 18px;
    margin: 0;
  }

  .categories {
    display: grid;
    gap: 40px;
    margin-top: 64px;
  }

  @media (width >= 62.5rem) {
    .kit {
      display: grid;
      grid-template-columns: 380px minmax(0, 1fr);
      gap: 56px;
      align-items: start;
    }

    .inner :global(.plate.cluster) {
      margin: 0;
      padding: 34px 30px 36px;
    }

    .gauges {
      flex-direction: column;
      gap: 18px;
    }

    .gauges > :global(.gauge) {
      flex: none;
      flex-direction: row;
      gap: 22px;
      text-align: left;
    }

    .gauges > :global(.gauge dt) {
      max-width: none;
      margin-top: 0;
    }

    .gauges > :global(.gauge .dial) {
      --dial: 128px;
    }

    .categories {
      margin-top: 0;
    }
  }

  @media (width >= 62.5rem) and (height >= 56.25rem) {
    .inner :global(.plate.cluster) {
      position: sticky;
      top: 100px;
    }
  }

  @media (width <= 40rem) {
    .inner {
      padding-inline: 16px;
    }

    .inner :global(.plate.cluster) {
      padding: 38px 12px 30px;
    }

    .gauges {
      gap: 28px 8px;
    }

    .gauges > :global(.gauge) {
      flex-basis: 136px;
    }

    .gauges > :global(.gauge .dial) {
      --dial: 128px;
      padding: 5px;
    }

    .gauges > :global(.gauge dt) {
      font-size: 13px;
    }
  }
</style>
