---
/*
 * The step dial under a workflow's diagram, on a gunmetal bar dark in both
 * themes: a previous-step knob, a machined dial with one tick per step
 * across a 270deg scale and a gold needle on the current step, the step
 * number inlaid in gold over "of <count>", and a next-step knob. The dial is
 * a slider (aria-valuenow, aria-valuetext) that the arrow keys, Page Up and
 * Page Down, Home and End and dragging turn. It renders hidden: only
 * src/scripts/flow.ts, which runs it, shows it, and not under reduced
 * motion, when every step is lit at once.
 */
import { stepTicks } from "../../scripts/flow";
import Knob from "../UI/Knob.astro";

interface Props {
  /** The number of steps. */
  count: number;
  /** The first step's title, the slider's text before the script runs. */
  first: string;
  /** The slider's accessible name, the words between step and count, and the knobs' names. */
  labels: { label: string; of: string; previous: string; next: string };
}

const { count, first, labels } = Astro.props;
---

<div class="step-dial" hidden>
  <Knob compact icon="arrow-left" label={labels.previous} class="dial-prev" />
  <div
    class="dial-knob"
    role="slider"
    tabindex="0"
    aria-label={labels.label}
    aria-valuemin="1"
    aria-valuemax={count}
    aria-valuenow="1"
    aria-valuetext={`1 ${labels.of} ${count}: ${first}`}
    data-of={labels.of}
  >
    <span class="dial-face" aria-hidden="true">
      <svg viewBox="0 0 100 100" class="dial-ticks">
        {stepTicks(count).map((tick) => (
          <line x1={tick.x1} y1={tick.y1} x2={tick.x2} y2={tick.y2} />
        ))}
      </svg>
      <span class="dial-rotor" style="transform: rotate(-135deg)">
        <span class="dial-needle"></span>
      </span>
      <span class="dial-hub spun"></span>
    </span>
  </div>
  <p class="dial-readout" aria-hidden="true">
    <b>01</b>
    <small>
      {labels.of} {String(count).padStart(2, "0")}
    </small>
  </p>
  <Knob compact icon="arrow-right" label={labels.next} class="dial-next" />
</div>

<style>
  /* The bar: brushed gunmetal with a lit top lip, under the diagram window. */
  .step-dial {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 18px;
    margin-top: 14px;
    padding: 12px 18px;
    border-radius: 16px;
    background-image:
      var(--brush-noise-soft), linear-gradient(180deg, #2b3138, #1b1f24);
    background-size:
      320px 140px,
      100% 100%;
    background-blend-mode: overlay, normal;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      inset 0 -1px 0 rgb(0 0 0 / 0.6),
      0 0 0 1px rgb(214 222 232 / 0.08),
      calc(var(--lean) * var(--slant) * 8px) 8px 18px -10px rgb(0 0 0 / 0.8);
  }

  .step-dial[hidden] {
    display: none;
  }

  /*
   * The dial: a chamfered steel bezel around a dark face of raised ticks,
   * one per step, gold up to the current step (.passed); the gold needle
   * (.dial-rotor, turned by flow.ts) sits on a spun hub. A grab hand shows it
   * turns; vertical swipes still scroll the page on touch screens.
   */
  .dial-knob {
    position: relative;
    flex: none;
    width: 76px;
    height: 76px;
    padding: 5px;
    border-radius: 50%;
    background: linear-gradient(215deg, #fff, #9aa1aa 45%, #2f343a);
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.6),
      calc(var(--lean) * var(--slant) * 4px) 4px 10px -2px rgb(0 0 0 / 0.8);
    cursor: grab;
    touch-action: pan-y;
  }

  .dial-knob:active {
    cursor: grabbing;
  }

  .dial-knob:focus-visible {
    outline: 2px solid #e6c56c;
    outline-offset: 3px;
  }

  .dial-face {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 35%, #2a2f36, #111317 70%);
    box-shadow: inset 0 2px 6px rgb(0 0 0 / 0.8);
  }

  .dial-ticks {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dial-ticks line {
    stroke: rgb(214 222 232 / 0.45);
    stroke-width: 3;
    stroke-linecap: round;
    transition: stroke 0.3s var(--ease-soft);
  }

  .dial-ticks line:global(.passed) {
    stroke: #e6c56c;
  }

  .dial-rotor {
    position: absolute;
    inset: 0;
    transition: transform 0.45s var(--ease-soft);
  }

  .dial-needle {
    position: absolute;
    top: 14%;
    left: calc(50% - 1.5px);
    width: 3px;
    height: 38%;
    border-radius: 2px;
    background: linear-gradient(180deg, #fff4cc, #e3bf62 40%, #9c7726);
    box-shadow: 0 0 6px rgb(230 192 98 / 0.6);
  }

  .dial-hub {
    position: absolute;
    top: calc(50% - 8px);
    left: calc(50% - 8px);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.6);
  }

  /* The readout: the step number in gold over "of <count>" in steel mono. */
  .dial-readout {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 4ch;
    margin: 0;
    font-family: var(--font-mono);
  }

  .dial-readout b {
    color: #f2d17b;
    font-size: 24px;
    font-weight: 600;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .dial-readout small {
    color: #8b94a0;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .dial-rotor,
    .dial-ticks line {
      transition: none;
    }
  }
</style>
