---
/*
 * One workflow's page body: its title block (the workflows section's
 * numbered eyebrow, the title in gold, the summary, and for a peer's
 * workflow a "Contributed by" credit with its author's name and links), the
 * problem on a machined panel, the step-through, the weak points and their
 * compensations when the workflow names any, the trade-offs and the stack,
 * then a port back to the home page's workflows section.
 *
 * The step-through ([data-workflow-steps]) holds the diagram's column
 * (.flow-visual) above the captions, an ordered list of every step with its
 * text and its failure mode, each item carrying the parts and edges its step
 * lights in data-lights and data-hops. The column stacks the 2D
 * gold-inlay diagram (figure.flow) and the 3D board (.board3d) in one grid
 * cell, over the step bar. Without JavaScript only the list shows;
 * src/scripts/flow.ts sets data-flow, which shows the column above the list,
 * and with data-flow="step" only the current step's caption shows.
 * The column carries the board's aspect ratio (--board-aspect) for its
 * width. The 3D board takes the cell from the start, its outline glowing
 * faintly until it has drawn its first frame (.board3d[data-ready]), then
 * fading in, with the 2D diagram unseen under it; where the board cannot
 * run, Board3D.astro hides it (hidden) and the 2D diagram shows instead.
 */
import { sectionNumber, workflows } from "../../data/index";
import type { Workflow } from "../../data/types";
import { boardAspect, layoutBoard } from "../../scripts/board3d";
import { stepHops } from "../../scripts/flow";
import Emphasis from "../UI/Emphasis.astro";
import Panel from "../UI/Panel.astro";
import Port from "../UI/Port.astro";
import Tag from "../UI/Tag.astro";
import Board3D from "./Board3D.astro";
import FlowDiagram from "./FlowDiagram.astro";
import StepBar from "./StepBar.astro";

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
const { page } = workflows;
const number = String(sectionNumber(workflows.id)).padStart(2, "0");
const hops = stepHops(workflow.steps, workflow.edges);
const aspect = boardAspect(layoutBoard(workflow.nodes)).toFixed(4);
const pad = (value: number) => String(value).padStart(2, "0");
---

<article class="workflow">
  <header class="head">
    <p class="eyebrow">
      <span class="eyebrow-no">{number}</span> {workflows.label}
    </p>
    <h1 class="h2">
      <span class="gilt">{workflow.title}</span>
    </h1>
    <p class="lede">
      <Emphasis text={workflow.summary} />
    </p>
    {workflow.author && (
      <div class="credit">
        <p class="credit-label">{workflows.contributedBy}</p>
        <p class="credit-name">{workflow.author.name}</p>
        <ul class="credit-links">
          {workflow.author.links.map((link) => (
            <li>
              <Port link={link} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </header>

  <Panel as="section" class="problem" aria-labelledby="workflow-problem">
    <h2 id="workflow-problem" class="part-title">
      {page.problem}
    </h2>
    <p>
      <Emphasis text={workflow.problem} />
    </p>
  </Panel>

  <section
    class="steps-part"
    aria-labelledby="workflow-steps"
    data-workflow-steps
  >
    <h2 id="workflow-steps" class="part-title">
      {page.steps}
    </h2>
    <div class="step-through">
      <div class="flow-visual" style={`--board-aspect: ${aspect}`}>
        <FlowDiagram
          label={page.diagram}
          nodes={workflow.nodes}
          edges={workflow.edges}
        />
        <Board3D workflow={workflow} />
        <StepBar workflow={workflow} labels={page.bar} failure={page.failure} />
      </div>
      <ol class="steps">
        {workflow.steps.map((step, index) => (
          <li
            id={`workflow-step-${index + 1}`}
            data-lights={step.lights.join(" ")}
            data-hops={hops[index]!.join(" ")}
          >
            <span class="step-no eyebrow-no" aria-hidden="true">
              {pad(index + 1)}
            </span>
            <h3>{step.title}</h3>
            <p class="step-text">
              <Emphasis text={step.text} />
            </p>
            {step.failure && (
              <p class="step-failure">
                <span class="step-key">{page.failure}</span>{" "}
                <Emphasis text={step.failure} />
              </p>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  {workflow.compensations && workflow.compensations.length > 0 && (
    <Panel
      as="section"
      class="compensations"
      aria-labelledby="workflow-compensations"
    >
      <h2 id="workflow-compensations" class="part-title">
        {page.compensations.title}
      </h2>
      <ul>
        {workflow.compensations.map((item) => (
          <li>
            <p class="weakness">
              <span class="comp-key">{page.compensations.weakness}</span>{" "}
              <Emphasis text={item.weakness} />
            </p>
            <span class="comp-arrow" aria-hidden="true"></span>
            <p class="compensation">
              <span class="comp-key">{page.compensations.compensation}</span>{" "}
              <Emphasis text={item.compensation} />
            </p>
          </li>
        ))}
      </ul>
    </Panel>
  )}

  <Panel as="section" class="tradeoffs" aria-labelledby="workflow-tradeoffs">
    <h2 id="workflow-tradeoffs" class="part-title">
      {page.tradeoffs}
    </h2>
    <ul>
      {workflow.tradeoffs.map((tradeoff) => (
        <li>
          <Emphasis text={tradeoff} />
        </li>
      ))}
    </ul>
  </Panel>

  <section class="stack" aria-labelledby="workflow-stack">
    <h2 id="workflow-stack" class="part-title">
      {page.stack}
    </h2>
    <ul class="tags">
      {workflow.stack.map((tool) => (
        <Tag as="li">{tool}</Tag>
      ))}
    </ul>
  </section>

  <p class="back">
    <Port link={{ ...page.back, url: `/${page.back.url}` }} />
  </p>
</article>

<script>
  import { startFlow } from "../../scripts/flow";

  const root = document.querySelector<HTMLElement>("[data-workflow-steps]");
  if (root) startFlow(root);
</script>

<style>
  /*
   * The page: one column as wide as the home sections, under room for the
   * brand mark that hangs below the header while the page is at its top.
   */
  .workflow {
    display: grid;
    gap: clamp(40px, 6vw, 72px);
    max-width: var(--container-page);
    margin-inline: auto;
    padding: 72px 28px clamp(84px, 10vw, 140px);
  }

  .head {
    max-width: 68ch;
  }

  .head .h2 {
    margin-bottom: 18px;
  }

  .lede {
    margin: 0;
    color: var(--body);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.72;
  }

  .credit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 16px;
    margin: 24px 0 0;
  }

  .credit-label {
    margin: 0;
    color: var(--label);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .credit-name {
    margin: 0;
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
  }

  .credit-links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* A part's heading: gold spaced capitals led by a short gold rule. */
  .part-title {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 20px;
    color: var(--gold-text);
    font-family: var(--font-mono);
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .part-title::before {
    content: "";
    width: 22px;
    height: 1px;
    background: currentColor;
  }

  .workflow :global(.panel.problem),
  .workflow :global(.panel.compensations),
  .workflow :global(.panel.tradeoffs) {
    padding: 28px 32px 30px;
    border-radius: 22px;
  }

  .problem p {
    max-width: 72ch;
    margin: 0;
    color: var(--body);
    font-size: 16.5px;
    line-height: 1.7;
  }

  /*
   * The step-through: the captions alone until flow.ts sets data-flow; then
   * the diagram's column (.flow-visual) sits above them, as wide as the page
   * and, from 1080px, wider: up to 1400px and the viewport less 28px each
   * side, centred on the page, but no wider than keeps the board and the step
   * bar (16rem with the header and gaps) within the viewport's height, and
   * at least 640px.
   */
  .step-through {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
  }

  .flow-visual {
    position: relative;
    display: none;
  }

  :global([data-flow]) > .step-through .flow-visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: 14px;
  }

  /*
   * The 2D diagram and the 3D board share the column's first cell, over the
   * step bar in the second row. The board sizes the cell from the start, at
   * its own aspect ratio, its outline glowing faintly until its first frame
   * (Board3D.astro); the diagram lies under it, clipped to the board's box,
   * unseen, clear of the pointer and with every animation paused
   * (!important outranks FlowDiagram.astro's more specific data-flow="step"
   * animation rules). Where the board cannot run, Board3D.astro hides it and
   * the diagram sizes the cell and shows. Each grid-area names its end
   * lines, since an absolutely positioned item's auto end line is the
   * column's padding edge.
   */
  .flow-visual > :global(.flow),
  .flow-visual > :global(.board3d) {
    grid-area: 1 / 1 / 2 / 2;
    min-width: 0;
  }

  .flow-visual > :global(.flow) {
    transition: opacity 0.6s var(--ease-soft);
  }

  .flow-visual:has(> :global(.board3d:not([hidden]))) > :global(.flow) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .flow-visual:has(> :global(.board3d:not([hidden])))
    > :global(.flow)
    :global(*),
  .flow-visual:has(> :global(.board3d:not([hidden])))
    > :global(.flow)
    :global(*)::before,
  .flow-visual:has(> :global(.board3d:not([hidden])))
    > :global(.flow)
    :global(*)::after {
    animation-play-state: paused !important;
  }

  .flow-visual > :global(.step-bar) {
    grid-area: 2 / 1 / 3 / 2;
  }

  @media (width >= 67.5rem) {
    :global([data-flow]) > .step-through .flow-visual {
      --visual-width: min(
        100vw - 3.5rem,
        87.5rem,
        max(40rem, (100svh - 16rem) * var(--board-aspect))
      );
      width: var(--visual-width);
      margin-inline: calc((100% - var(--visual-width)) / 2);
    }
  }

  /*
   * The captions: each step numbered on an engraved plate, its title, its
   * text and its failure mode in --ember, the text at most 72ch wide. The
   * current step (aria-current="step") is lit gold from the left; while the
   * step-through runs (data-flow="step") it is the only caption shown.
   */
  .steps {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    position: relative;
    padding: 20px 22px 22px 64px;
    border-radius: 16px;
    box-shadow: inset 0 0 0 1px var(--line);
    transition:
      background-color 0.35s var(--ease-soft),
      box-shadow 0.35s var(--ease-soft);
  }

  :global([data-flow="step"]) .steps li:not([aria-current]) {
    display: none;
  }

  .steps li[aria-current="step"] {
    background: linear-gradient(
      90deg,
      rgb(var(--particle-gold) / 0.1),
      transparent 70%
    );
    box-shadow:
      inset 2px 0 0 var(--gold-text),
      inset 0 0 0 1px var(--line);
  }

  .step-no {
    position: absolute;
    top: 20px;
    left: 18px;
  }

  .steps h3 {
    margin: 2px 0 8px;
    color: var(--text);
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .step-text {
    max-width: 72ch;
    margin: 0;
    color: var(--body);
    font-size: 15.5px;
    line-height: 1.65;
  }

  .step-failure {
    max-width: 72ch;
    margin: 12px 0 0;
    color: var(--body);
    font-size: 13.5px;
    line-height: 1.55;
  }

  .step-key {
    margin-right: 6px;
    color: var(--ember);
    font-weight: 600;
  }

  /*
   * Weak points and compensations: each row a weak point, labelled in
   * --ember, then a gold arrow to its compensation, labelled in
   * --gold-text; rows split by --line rules, and stacked without the arrow
   * below 860px.
   */
  .compensations ul {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .compensations li {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) 34px minmax(0, 1.15fr);
    align-items: start;
    gap: 12px 18px;
    padding: 18px 0;
  }

  .compensations li + li {
    border-top: 1px solid var(--line);
  }

  .compensations li:first-child {
    padding-top: 4px;
  }

  .compensations li:last-child {
    padding-bottom: 0;
  }

  .weakness,
  .compensation {
    margin: 0;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }

  .comp-key {
    display: block;
    margin-bottom: 4px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .weakness .comp-key {
    color: var(--ember);
  }

  .compensation .comp-key {
    color: var(--gold-text);
  }

  .compensation :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  /* The arrow: a gold rule ending in a chevron, level with the labels. */
  .comp-arrow {
    position: relative;
    height: 1px;
    margin-top: 9px;
    background: linear-gradient(90deg, transparent, var(--gold-text));
  }

  .comp-arrow::after {
    content: "";
    position: absolute;
    top: -3.5px;
    right: 0;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--gold-text);
    border-right: 1px solid var(--gold-text);
    transform: rotate(45deg);
  }

  @media (width <= 53.75rem) {
    .compensations li {
      grid-template-columns: minmax(0, 1fr);
      gap: 10px;
    }

    .comp-arrow {
      display: none;
    }
  }

  /* Trade-offs, each led by a short gold rule. */
  .tradeoffs ul {
    display: grid;
    gap: 12px;
    max-width: 76ch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tradeoffs li {
    position: relative;
    padding-left: 22px;
    color: var(--body);
    font-size: 15.5px;
    line-height: 1.6;
  }

  .tradeoffs li::before {
    content: "";
    position: absolute;
    top: 0.8em;
    left: 0;
    width: 10px;
    height: 1px;
    background: var(--gold-text);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .back {
    margin: 0;
  }

  @media (width <= 40rem) {
    .workflow {
      padding-inline: 16px;
    }

    .workflow :global(.panel.problem),
    .workflow :global(.panel.compensations),
    .workflow :global(.panel.tradeoffs) {
      padding: 22px 20px 24px;
    }

    .steps li {
      padding: 18px 16px 20px 56px;
    }

    .step-no {
      left: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .steps li,
    .flow-visual > :global(.flow) {
      transition: none;
    }
  }
</style>
