---
/*
 * One workflow on a machined Panel in the home page's workflows section: its
 * part and step counts in mono, its title, its summary, its stack as tags,
 * the author of a peer's workflow, and a port to its page.
 */
import { workflows } from "../../data/index";
import type { Workflow } from "../../data/types";
import Emphasis from "../UI/Emphasis.astro";
import Panel from "../UI/Panel.astro";
import Port from "../UI/Port.astro";
import Tag from "../UI/Tag.astro";

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
const { counts } = workflows;
---

<Panel as="article" class="workflow-card">
  <p class="counts">
    {workflow.nodes.length}
    {counts.nodes} · {workflow.steps.length}
    {counts.steps}
  </p>
  <h3>{workflow.title}</h3>
  <p class="summary">
    <Emphasis text={workflow.summary} />
  </p>
  <ul class="tags">
    {workflow.stack.map((tool) => (
      <Tag as="li">{tool}</Tag>
    ))}
  </ul>
  {workflow.author && (
    <p class="author">
      {workflows.contributedBy} <b>{workflow.author.name}</b>
    </p>
  )}
  <p class="open">
    <Port
      link={{ title: workflows.open, url: workflow.path, icon: "arrow-right" }}
    />
  </p>
</Panel>

<style>
  /* The summary grows, so the tags and ports of cards in a row line up. */
  :global(.panel).workflow-card {
    display: flex;
    flex-direction: column;
    padding: 28px 30px 24px;
    border-radius: 24px;
  }

  .counts {
    margin: 0 0 12px;
    color: var(--gold-text);
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0 0 10px;
    color: var(--text);
    font-size: 21px;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .summary {
    flex: 1;
    margin: 0 0 20px;
    color: var(--body);
    font-size: 15.5px;
    line-height: 1.65;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags :global(.tag) {
    font-size: 11.5px;
  }

  .author {
    margin: 16px 0 0;
    color: var(--label);
    font-size: 13.5px;
  }

  .author b {
    color: var(--text);
    font-weight: 600;
  }

  .open {
    margin: 20px 0 0;
    padding-top: 16px;
    border-top: 1px solid var(--line);
  }

  @media (width <= 40rem) {
    :global(.panel).workflow-card {
      padding: 24px 20px 20px;
    }
  }
</style>
