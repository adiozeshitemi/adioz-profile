---
/*
 * A workflow's 3D board, one island: div.board3d[data-board3d] holding a
 * canvas, hidden from assistive technology, and the board's data (its
 * silkscreen name, the designer's mark and the slug (boardName), the parts' ids, names, cells and kinds, the hops, each
 * step's lit parts and each step's card: its title, text and failure mode,
 * with the failure label) as JSON. The div takes the board's aspect ratio
 * (boardAspect) and stays invisible until src/scripts/board3d.ts sets
 * data-ready after its first frame. After first paint, when the browser is
 * idle and a WebGL2 context can be created, the script imports
 * src/scripts/board3d.ts, which loads with Three.js in chunks apart from the
 * page's script, and starts every board on the page.
 */
import { workflows } from "../../data/index";
import type { Workflow } from "../../data/types";
import {
  boardAspect,
  boardName,
  kindOf,
  layoutBoard,
  type BoardData,
} from "../../scripts/board3d";

interface Props {
  workflow: Workflow;
}

const { workflow } = Astro.props;
const data: BoardData = {
  name: boardName(workflow.slug, workflow.author?.name),
  nodes: workflow.nodes.map(({ id, label, col, row, kind }) => ({
    id,
    label,
    col,
    row,
    kind: kindOf({ kind }),
  })),
  edges: workflow.edges.map(({ from, to, label }) => ({ from, to, label })),
  steps: workflow.steps.map((step) => step.lights),
  cards: workflow.steps.map(({ title, text, failure }) =>
    failure ? { title, text, failure } : { title, text },
  ),
  failure: workflows.page.failure,
};
const aspect = boardAspect(layoutBoard(data.nodes)).toFixed(4);
/** The data as JSON safe inside a script element. */
const json = JSON.stringify(data).replace(/</g, "\\u003c");
---

<div class="board3d" data-board3d style={`--board-aspect: ${aspect}`}>
  <canvas aria-hidden="true"></canvas>
  <script type="application/json" set:html={json} />
</div>

<script>
  /*
   * Starts the board in every .board3d[data-board3d] when the browser is idle
   * after the page's first paint, only where a WebGL2 context can be created.
   */
  const hosts = [
    ...document.querySelectorAll<HTMLElement>(".board3d[data-board3d]"),
  ];
  const webgl = () => {
    try {
      return !!document.createElement("canvas").getContext("webgl2");
    } catch {
      return false;
    }
  };
  const load = () => {
    if (hosts.length === 0 || !webgl()) return;
    void import("../../scripts/board3d").then(({ startBoard }) => {
      for (const host of hosts) startBoard(host);
    });
  };
  requestAnimationFrame(() => {
    if ("requestIdleCallback" in window) {
      requestIdleCallback(load, { timeout: 2000 });
    } else {
      setTimeout(load, 200);
    }
  });
</script>

<style>
  /*
   * The board: as wide as its container at the board's aspect ratio, clear
   * to the pointer until its first frame (data-ready), invisible until then
   * and, once ready, its canvas taking the pointer for the hover card. Behind
   * the canvas, ::before pools the page's light under the board, where its
   * shadow falls: a faint cool pool on the dark theme, a bright white one on
   * the light theme.
   */
  .board3d {
    --board-pool: radial-gradient(
      ellipse 50% 50% at 50% 54%,
      rgb(196 206 220 / 0.07),
      rgb(196 206 220 / 0.025) 62%,
      transparent
    );
    position: relative;
    width: 100%;
    aspect-ratio: var(--board-aspect, 1.52);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.8s var(--ease-soft);
  }

  :global([data-theme="light"]) .board3d {
    --board-pool: radial-gradient(
      ellipse 50% 50% at 50% 52%,
      rgb(255 255 255 / 0.75),
      rgb(255 255 255 / 0.3) 62%,
      transparent
    );
  }

  .board3d::before {
    content: "";
    position: absolute;
    inset: -8% 0;
    background: var(--board-pool);
  }

  .board3d[data-ready] {
    opacity: 1;
  }

  .board3d[data-ready] canvas {
    pointer-events: auto;
  }

  /*
   * The hover card (board3d.ts): the step's number plate, title, text and
   * failure mode on a panel beside the part under the mouse, inside the
   * board and clear of the pointer.
   */
  .board3d :global(.board-card) {
    position: absolute;
    z-index: 1;
    width: min(26rem, calc(100% - 16px));
    padding: 14px 18px 16px;
    border-radius: 14px;
    background: var(--panel-face);
    box-shadow:
      inset 0 0 0 1px var(--line),
      0 22px 44px -16px rgb(0 0 0 / 0.6);
    pointer-events: none;
  }

  .board3d :global(.board-card-head) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
  }

  .board3d :global(.board-card-title) {
    color: var(--text);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }

  .board3d :global(.board-card-text) {
    margin: 0;
    color: var(--body);
    font-size: 14.5px;
    line-height: 1.6;
  }

  .board3d :global(.board-card-failure) {
    margin: 10px 0 0;
    color: var(--body);
    font-size: 13px;
    line-height: 1.5;
  }

  .board3d :global(.board-card-failure > span) {
    margin-right: 4px;
    color: var(--ember);
    font-weight: 600;
  }

  .board3d canvas {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .board3d {
      transition: none;
    }
  }
</style>
