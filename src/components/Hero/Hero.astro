---
/*
 * The first screen: profile.json's availability badge, name and headline,
 * role and specialty, summary, call-to-action links and social links beside
 * the terminal, with the stats banner underneath.
 */
import { profile } from "../../data/index";
import Badge from "../UI/Badge.astro";
import Button from "../UI/Button.astro";
import Emphasis from "../UI/Emphasis.astro";
import Icon from "../UI/Icon.astro";
import StatBanner from "../UI/StatBanner.astro";
import SocialLinks from "./SocialLinks.astro";
import Terminal from "./Terminal.astro";
---

<section class="hero" aria-labelledby="hero-title">
  <div class="inner">
    <div class="grid">
      <div class="copy">
        <div class="status">
          <Badge variant="status">{profile.availability}</Badge>
        </div>
        <h1 id="hero-title">
          {profile.name}
          <br />
          <span class="headline">{profile.headline}</span>
        </h1>
        <p class="role">
          {profile.role}
          <span class="separator">/</span>
          {profile.specialty}
        </p>
        <p class="summary">
          <Emphasis text={profile.summary} />
        </p>
        <div class="actions">
          {profile.actions.map((action, index) => (
            <Button
              href={action.url}
              variant={index === 0 ? "primary" : "ghost"}
              icon={action.icon}
            >
              {action.title}
            </Button>
          ))}
          <a class="resume" href={profile.resume.url} download>
            <Icon name={profile.resume.icon} size={15} />
            {profile.resume.title}
          </a>
        </div>
        <SocialLinks />
      </div>
      <Terminal />
    </div>
    <div class="stats">
      <StatBanner />
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 3.875rem 4.375rem;
  }

  .inner {
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: 1.25rem;
  }

  .grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  .status {
    margin-bottom: 1.625rem;
  }

  h1 {
    margin-bottom: 1.125rem;
    font-size: clamp(2.8rem, 6.6vw, 4.6rem);
    font-weight: 800;
    line-height: 1.02;
    letter-spacing: -0.04em;
    color: var(--color-ink);
  }

  /* The gradient ends on the color it starts with, so the repeating tiles that text-shine slides across the text join without a seam. */
  .headline {
    background: linear-gradient(
      100deg,
      var(--color-accent-cyan) 0%,
      var(--color-accent-violet) 33%,
      var(--color-accent-pink) 66%,
      var(--color-accent-cyan) 100%
    );
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: var(--animate-text-shine);
  }

  .role {
    margin-bottom: 1.375rem;
    font-size: clamp(0.85rem, 1.6vw, 1rem);
    letter-spacing: 0.01em;
    color: var(--color-ink-muted);
  }

  .separator {
    margin-inline: 0.5rem;
    color: var(--color-accent-cyan);
  }

  .summary {
    max-width: 56ch;
    margin-bottom: 2.125rem;
    font-size: clamp(1rem, 1.5vw, 1.115rem);
    color: var(--color-ink-muted);
  }

  .summary :global(strong) {
    font-weight: 600;
    color: var(--color-ink);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 2.125rem;
  }

  .resume {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8125rem 0.5rem;
    border-radius: 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-ink-muted);
    text-underline-offset: 0.25em;
    transition: color 0.25s;
  }

  .resume:hover {
    color: var(--color-ink);
    text-decoration: underline;
  }

  .resume:focus-visible {
    outline: 2px solid var(--color-accent-cyan);
    outline-offset: 3px;
  }

  .stats {
    margin-top: 3.5rem;
  }

  /* Below --breakpoint-xs: the call-to-action links stack at full width. */
  @media (width < 26.25rem) {
    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .actions :global(.btn),
    .resume {
      justify-content: center;
    }
  }

  /* --breakpoint-md */
  @media (width >= 47.5rem) {
    .inner {
      padding-inline: 1.75rem;
    }
  }

  /* --breakpoint-lg: copy and terminal side by side, filling the first screen. */
  @media (width >= 65rem) {
    .hero {
      display: flex;
      flex-direction: column;
      justify-content: center;
      min-height: calc(100svh - var(--spacing-header));
      padding-top: 5.125rem;
    }

    .grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 4rem;
    }

    .stats {
      margin-top: 4.625rem;
    }
  }
</style>
