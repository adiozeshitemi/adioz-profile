---
/*
 * The first screen: profile.json's availability pill, gold headline, lede and
 * actions, the stats panel and the social links beside the 3D agent pipeline
 * and its agent log.
 */
import { profile } from "../../data/index";
import Button from "../UI/Button.astro";
import Emphasis from "../UI/Emphasis.astro";
import Knob from "../UI/Knob.astro";
import Lamp from "../UI/Lamp.astro";
import Panel from "../UI/Panel.astro";
import Pipeline3D from "./Pipeline3D.astro";
import StatBanner from "../UI/StatBanner.astro";
import SocialLinks from "./SocialLinks.astro";
import Terminal from "./Terminal.astro";

/** The direction each action icon points, in degrees clockwise, read by the light script. */
const ICON_REST: Record<string, number> = {
  "arrow-right": 90,
  send: 45,
  download: 180,
};
---

<section class="hero" aria-labelledby="hero-title">
  <div class="inner">
    <div class="grid">
      <div class="copy">
        <Panel as="p" gold class="pill">
          <Lamp />
          {profile.availability}
        </Panel>
        <h1 id="hero-title" class="display">
          <span class="gilt">
            {profile.name} {profile.headline}
          </span>
        </h1>
        <p class="lede">
          {profile.role} / {profile.specialty}.{" "}
          <Emphasis text={profile.summary} />
        </p>
        <div class="actions">
          {profile.actions.map((action) => (
            <Button
              variant="accent"
              href={action.url}
              icon={action.icon}
              rest={ICON_REST[action.icon]}
            >
              {action.title}
            </Button>
          ))}
          <span class="resume">
            <Knob
              href={profile.resume.url}
              download={profile.resume.file}
              label={profile.resume.label}
              icon={profile.resume.icon}
              rest={ICON_REST[profile.resume.icon]}
            />
            <span class="resume-title" aria-hidden="true">
              {profile.resume.title}
            </span>
          </span>
        </div>
        <StatBanner class="hero-stats" />
        <SocialLinks />
      </div>
      <div class="system">
        <Pipeline3D />
        <Terminal />
      </div>
    </div>
  </div>
</section>

<style>
  /*
   * Below 1020px the copy stacks above the pipeline and its log; from 1020px they sit
   * side by side and the hero fills the first screen under the header.
   */
  .hero {
    display: flex;
    align-items: center;
    padding-block: 72px 80px;
  }

  .inner {
    width: 100%;
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: 28px;
  }

  .grid {
    display: grid;
    gap: 56px;
    align-items: center;
  }

  .copy,
  .system {
    min-width: 0;
  }

  .system {
    display: grid;
    gap: 18px;
  }

  /* The availability pill: a gold-rimmed machined slab on a 3px wall, led by the status lamp. */
  .copy :global(.panel.pill) {
    --depth: 3px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 28px;
    padding: 7px 15px 7px 11px;
    border-radius: 999px;
    color: var(--text);
    font-size: 12.5px;
    letter-spacing: 0.02em;
  }

  .lede {
    max-width: 54ch;
    margin: 0 0 34px;
    color: var(--body);
    font-size: clamp(16px, 1.4vw, 18px);
    line-height: 1.72;
  }

  .lede :global(strong) {
    color: var(--text);
    font-weight: 500;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 18px;
  }

  .resume {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    color: var(--text);
    font-size: 14.5px;
    font-weight: 500;
  }

  .copy :global(.hero-stats) {
    margin-top: 48px;
  }

  .copy :global(.socials) {
    margin-top: 28px;
  }

  @media (width <= 40rem) {
    .inner {
      padding-inline: 16px;
    }
  }

  @media (width >= 63.75rem) {
    .hero {
      min-height: calc(100svh - var(--spacing-header));
      padding-block: 88px 80px;
    }

    .grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: clamp(28px, 4vw, 64px);
    }
  }
</style>
