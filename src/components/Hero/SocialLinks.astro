---
/*
 * profile.json's GitHub, LinkedIn and email links as icon buttons; each link's
 * title is the icon's accessible name, and https: links open in a new tab.
 */
import { profile } from "../../data/index";
import Icon from "../UI/Icon.astro";
---

<ul class="socials">
  {profile.links.map((link) => (
    <li>
      <a
        href={link.url}
        {...(link.url.startsWith("https:")
          ? { target: "_blank", rel: "noopener noreferrer" }
          : {})}
      >
        <Icon name={link.icon} label={link.title} size={17} />
      </a>
    </li>
  ))}
</ul>

<style>
  .socials {
    display: flex;
    gap: 0.625rem;
  }

  a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-line);
    border-radius: 0.6875rem;
    color: var(--color-ink-muted);
    transition:
      color 0.25s,
      border-color 0.25s,
      transform 0.25s var(--ease-soft),
      background-color 0.25s;
  }

  a:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--color-accent-cyan) 45%, transparent);
    background: color-mix(in srgb, var(--color-accent-cyan) 7%, transparent);
    color: var(--color-accent-cyan);
  }

  a:focus-visible {
    outline: 2px solid var(--color-accent-cyan);
    outline-offset: 2px;
  }
</style>
