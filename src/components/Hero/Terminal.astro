---
/*
 * The hero's agent log: terminal.json's title engraved in a gunmetal title
 * bar beside its window buttons and the red live lamp, and its entries on a
 * sunken screen. The markup holds every entry, each a writer (.who) and a
 * message toned good or bad; src/scripts/terminal.ts types them in with
 * their clock times and runs the window buttons, which the markup renders
 * disabled.
 */
import { terminal } from "../../data/index";
import Lamp from "../UI/Lamp.astro";
---

<div class="terminal" data-reveal>
  <button class="log-reopen" type="button" hidden>
    Open {terminal.name}
  </button>
  <figure class="log slab slab-dark" aria-labelledby="log-title">
    <div class="log-bar">
      <span class="window-controls">
        <button
          type="button"
          class="light close"
          aria-label={`Close ${terminal.name}`}
          disabled
        ></button>
        <button
          type="button"
          class="light min"
          aria-label={`Minimise ${terminal.name}`}
          aria-pressed="false"
          disabled
        ></button>
        <button
          type="button"
          class="light zoom"
          aria-label={`Zoom ${terminal.name}`}
          aria-pressed="false"
          disabled
        ></button>
      </span>
      <span id="log-title" class="engraved">
        {terminal.title}
      </span>
      <span class="live">
        <Lamp variant="live" />
        <span class="engraved">{terminal.live}</span>
      </span>
    </div>
    <ol class="screen" aria-live="off">
      {terminal.lines.map((line) => (
        <li>
          <span class="who">{line.who}</span>
          <span class:list={["message", line.tone]}>{line.text}</span>
        </li>
      ))}
    </ol>
  </figure>
  <div class="log-shade" popover="manual"></div>
</div>

<script>
  import { startLog, startWindow } from "../../scripts/terminal";

  const log = document.querySelector<HTMLElement>(".terminal .log");
  const screen = log?.querySelector<HTMLElement>(".screen");
  const reopen = document.querySelector<HTMLButtonElement>(".log-reopen");
  const shade = document.querySelector<HTMLElement>(".log-shade");
  if (log && screen && reopen && shade) {
    startLog(screen);
    startWindow(log, reopen, shade);
  }
</script>

<style>
  /*
   * The log is dark in both themes: a brushed gunmetal case on the dark
   * theme's --slab-wall (.slab-dark), a brushed title bar, and a screen sunk
   * into the case under faint scanlines (--scan) and a gold glow along its
   * top. Entries glow like a lit
   * display: writers in gold, good messages in pale gold, bad ones in ember.
   * Each typed entry slides in and types out, and the newest ends in a
   * blinking cursor. Below 560px entries drop their clock times.
   */
  .terminal {
    display: grid;
    min-width: 0;
  }

  .log {
    --scan: repeating-linear-gradient(
      180deg,
      rgb(255 255 255 / 0.025) 0 1px,
      transparent 1px 3px
    );
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    background-image:
      var(--brush-noise-soft), linear-gradient(190deg, #1f2328, #121418);
    background-size:
      320px 140px,
      100% 100%;
    background-blend-mode: overlay, normal;
    box-shadow:
      inset calc(var(--lean) * var(--slant) * 1px) 1px 0 rgb(255 255 255 / 0.1),
      var(--slab-wall),
      var(--slab-drop);
    color: #c9cfd7;
    font-family: var(--font-mono);
    font-size: 12px;
    transition:
      transform 0.45s var(--ease-soft),
      opacity 0.35s var(--ease-soft);
  }

  .log-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background-image:
      var(--brush-noise-soft), linear-gradient(180deg, #2b3138, #1b1f24);
    background-size:
      320px 140px,
      100% 100%;
    background-blend-mode: overlay, normal;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      inset 0 -1px 0 rgb(0 0 0 / 0.6);
    font-size: 11.5px;
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-left: auto;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  /*
   * The window buttons in the macOS colours (--light), each showing its
   * symbol (×, −, +) while the controls are hovered or the button is focused.
   */
  .window-controls {
    display: flex;
    gap: 6px;
    margin-right: 6px;
  }

  .light {
    display: grid;
    place-items: center;
    width: 12px;
    height: 12px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background:
      radial-gradient(
        circle at 50% 30%,
        rgb(255 255 255 / 0.45),
        transparent 55%
      ),
      var(--light);
    box-shadow:
      inset 0 0 0 0.5px rgb(0 0 0 / 0.35),
      0 1px 1px rgb(0 0 0 / 0.5);
    color: rgb(60 20 10 / 0.75);
    font:
      700 10px/1 system-ui,
      sans-serif;
    cursor: pointer;
  }

  .light:disabled {
    cursor: default;
  }

  .light::after {
    opacity: 0;
    transition: opacity 0.15s;
  }

  .window-controls:hover .light:enabled::after,
  .light:focus-visible::after {
    opacity: 1;
  }

  .light:focus-visible {
    outline: 2px solid var(--gold-text);
    outline-offset: 2px;
  }

  .close {
    --light: #ff5f57;
  }

  .close::after {
    content: "×";
  }

  .min {
    --light: #febc2e;
  }

  .min::after {
    content: "−";
  }

  .zoom {
    --light: #28c840;
  }

  .zoom::after {
    content: "+";
  }

  .screen {
    display: grid;
    align-content: start;
    gap: 2px;
    min-height: calc(6 * 1.75em + 24px);
    max-height: 40em;
    margin: 8px;
    padding: 12px 14px;
    overflow: hidden;
    border-radius: 11px;
    list-style: none;
    line-height: 1.75;
    background:
      var(--scan),
      radial-gradient(
        120% 70% at 50% 0%,
        rgb(230 192 98 / 0.07),
        transparent 70%
      ),
      #06070a;
    box-shadow:
      inset 0 2px 10px rgb(0 0 0 / 0.85),
      inset 0 0 0 1px rgb(255 255 255 / 0.05);
    transition:
      max-height 0.45s var(--ease-soft),
      min-height 0.45s var(--ease-soft),
      padding 0.45s var(--ease-soft),
      margin 0.45s var(--ease-soft);
  }

  .screen li {
    display: grid;
    grid-template-columns: 10ch 1fr;
    gap: 10px;
  }

  .screen li:has(time) {
    grid-template-columns: 8ch 10ch 1fr;
  }

  .screen :global(time) {
    color: #8b94a0;
  }

  .who {
    color: #e6c56c;
    text-shadow: 0 0 8px rgb(230 192 98 / 0.45);
  }

  .good {
    color: #f2d17b;
    text-shadow: 0 0 8px rgb(242 209 123 / 0.4);
  }

  .bad {
    color: #f08a6a;
    text-shadow: 0 0 8px rgb(240 138 106 / 0.5);
  }

  .screen li:last-child .message::after {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 4px;
    vertical-align: -0.18em;
    background: #e6c56c;
    box-shadow: 0 0 8px rgb(230 192 98 / 0.7);
    animation: log-cursor 1.05s steps(1) infinite;
  }

  @media (width < 35rem) {
    .screen {
      font-size: 11.5px;
    }

    .screen li,
    .screen li:has(time) {
      grid-template-columns: 9.5ch 1fr;
      gap: 8px;
    }

    .screen :global(time) {
      display: none;
    }
  }

  .log.minimised .screen {
    min-height: 0;
    max-height: 0;
    margin-block: 0;
    padding-block: 0;
  }

  .log.closing {
    transform: scale(0.6) translateY(30px);
    opacity: 0;
  }

  .log.closed {
    display: none;
  }

  .log-reopen {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border: 0;
    border-radius: 10px;
    background-image:
      var(--brush-noise-soft), linear-gradient(180deg, #2b3138, #1b1f24);
    background-size:
      320px 140px,
      100% 100%;
    background-blend-mode: overlay, normal;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 6px 16px -6px rgb(0 0 0 / 0.6);
    color: #c9cfd7;
    font: 500 12px/1 var(--font-mono);
    cursor: pointer;
  }

  .log-reopen[hidden] {
    display: none;
  }

  .log-reopen:focus-visible {
    outline: 2px solid var(--gold-text);
    outline-offset: 3px;
  }

  .log-shade {
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(5 6 8 / 0.62);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }

  /* Zoomed, the log is a manual popover centred over the shade, up to 860px wide. */
  .log.zoomed {
    inset: 0;
    width: min(860px, 92vw);
    height: fit-content;
    margin: auto;
    padding: 0;
    border: 0;
    background-color: transparent;
    font-size: 14px;
  }

  .log.zoomed .screen {
    min-height: calc(14 * 1.75em + 24px);
  }

  @media (prefers-reduced-motion: no-preference) {
    .screen li {
      animation: log-line-in 0.5s var(--ease-soft);
    }

    .screen .message {
      animation: log-type 0.7s steps(28, end);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .log,
    .screen {
      transition: none;
    }

    .screen li:last-child .message::after {
      animation: none;
    }
  }

  @keyframes log-line-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes log-type {
    from {
      clip-path: inset(0 100% 0 0);
    }

    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes log-cursor {
    50% {
      opacity: 0;
    }
  }
</style>
