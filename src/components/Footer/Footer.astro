---
/*
 * The site footer from footer.json: a brushed gunmetal strip, dark in both
 * themes, holding the Dividers mark, "© <build year>" and the rights holder
 * engraved into the strip, and the compact back-to-top Knob.
 */
import { footer } from "../../data/index";
import BrandMark from "../UI/BrandMark.astro";
import Knob from "../UI/Knob.astro";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div class="footer-bar">
      <BrandMark label="" bright size={26} />
      <p class="copyright">
        © {year} {footer.copyright}
      </p>
      <Knob
        compact
        href={footer.top.url}
        icon={footer.top.icon}
        label={footer.top.title}
        class="to-top"
      />
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 30px 40px;
  }

  .inner {
    width: 100%;
    max-width: var(--container-page);
    margin-inline: auto;
    padding-inline: 28px;
  }

  /*
   * The strip: brushed gunmetal on a 4px wall slanted by --lean, its mark in
   * the dark theme's metals (bright) on both themes.
   */
  .footer-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 26px;
    padding: 12px 14px 12px 22px;
    border-radius: 14px;
    background-image:
      var(--brush-noise-soft), linear-gradient(190deg, #262b31, #15181c);
    background-size:
      320px 140px,
      100% 100%;
    background-blend-mode: overlay, normal;
    box-shadow:
      inset calc(var(--lean) * var(--slant) * 1px) 1px 0 rgb(255 255 255 / 0.13),
      0 0 0 1px rgb(0 0 0 / 0.55),
      calc(var(--lean) * var(--slant) * 2px) 2px 0 #3d4148,
      calc(var(--lean) * var(--slant) * 4px) 4px 0 #2f3237,
      calc(var(--lean) * var(--slant) * 4px) 4px 0 1px rgb(0 0 0 / 0.55),
      calc(var(--lean) * var(--slant) * 14px) 16px 34px -14px var(--metal-drop);
    font-family: var(--font-mono);
    font-size: 12.5px;
  }

  /*
   * The copyright is engraved into the strip like the log title, but set
   * small, so its cut has a shallower, lighter wall that keeps the text at
   * 4.5:1 or more against the strip.
   */
  .copyright {
    margin: 0;
    background-image: linear-gradient(
      180deg,
      #8a929c 0%,
      #a9b1bb 38%,
      #d6dce3 72%,
      #f2f5f8 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 -1px 0 #000)
      drop-shadow(0 -1px 0.5px rgb(0 0 0 / 0.85))
      drop-shadow(0 1px 0 rgb(255 255 255 / 0.3));
  }

  .footer-bar :global(.to-top) {
    margin-left: auto;
  }

  @media (width <= 40rem) {
    .inner {
      padding-inline: 16px;
    }
  }
</style>
