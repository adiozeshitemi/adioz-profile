---
import type { StatItem } from "../../data/types";

/**
 * One stats.json entry as a <dt>/<dd> pair inside StatBanner's <dl>.
 * The <dt> label comes first in the markup; column-reverse shows the value above it.
 * The number's data-count and data-decimals let src/scripts/motion.ts count
 * up to it; the HTML holds the final value.
 */
interface Props {
  stat: StatItem;
}

const { stat } = Astro.props;
const value = stat.value.toFixed(stat.decimals ?? 0);
---

<div class="stat">
  <dt class="label">{stat.label}</dt>
  <dd class="value gilt">
    <span data-count={stat.value} data-decimals={stat.decimals ?? 0}>
      {value}
    </span>
    <span class="suffix">{stat.suffix}</span>
  </dd>
</div>

<style>
  /*
   * A stat's .value is polished gold (.gilt) in tabular figures over its
   * --label caption; its flex layout drops the whitespace between the number
   * and its .suffix.
   */
  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    min-width: 0;
    padding: 18px 18px 16px;
  }

  .value {
    display: flex;
    align-items: baseline;
    width: fit-content;
    margin: 0;
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 340;
    line-height: 1.1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .label {
    margin-top: 6px;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--label);
  }

  @media (width <= 40rem) {
    .stat {
      padding: 14px 12px 12px;
    }
  }
</style>
