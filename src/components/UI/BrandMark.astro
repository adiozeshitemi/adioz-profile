---
interface Props {
  /** The accessible name; an empty string hides the mark, for a link that names itself. */
  label?: string;
  /** Keeps the dark theme's metals in both themes, for dark metal such as the footer strip. */
  bright?: boolean;
  /** Width and height in pixels. */
  size?: number;
  class?: string;
}

const {
  label = "adioz.dev",
  bright = false,
  size = 36,
  class: className,
} = Astro.props;
const steel = bright ? "url(#mark-steel-bright)" : "url(#mark-steel)";
const gold = bright ? "url(#mark-gold-bright)" : "url(#mark-gold)";
const named = label !== "";
---

<svg
  class:list={["brand-mark", className]}
  viewBox="9 8 46 46"
  width={size}
  height={size}
  role={named ? "img" : undefined}
  aria-label={named ? label : undefined}
  aria-hidden={named ? undefined : "true"}
  focusable="false"
>
  <g filter="url(#mark-raise)">
    <path
      class="leg-left"
      d="M28.6 17.4 33.8 19.4 18.4 52.6Z"
      fill={steel}
    ></path>
    <path
      class="leg-right"
      d="M35.4 17.4 30.2 19.4 45.6 52.6Z"
      fill={steel}
    ></path>
    <path
      class="arc"
      d="M22.4 37.6Q32 43.4 41.6 37.6"
      fill="none"
      stroke={gold}
      stroke-width="3.4"
      stroke-linecap="round"
    ></path>
    <circle cx="32" cy="15" r="6" fill={gold}></circle>
    <circle cx="32" cy="15" r="2" fill="#5a4210"></circle>
  </g>
</svg>

<style>
  /*
   * The Dividers mark: an "A" drawn as a pair of steel dividers hinged on a
   * gold pivot, the gold adjusting arc as its crossbar, standing off the page
   * through #mark-raise (gradients and filter in EngravingFilters.astro). The
   * gradients resolve their colours where they are defined, so the metals
   * follow data-theme on <html>, not on an element around the mark. Set
   * --spread on it or an ancestor to open the legs by that many degrees each,
   * the arc stretching with them; they spring to it.
   */
  .brand-mark {
    flex: none;
    overflow: visible;
  }

  .leg-left,
  .leg-right {
    transform-origin: 32px 17.5px;
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .leg-left {
    transform: rotate(calc(var(--spread, 0) * 1deg));
  }

  .leg-right {
    transform: rotate(calc(var(--spread, 0) * -1deg));
  }

  .arc {
    transform-origin: 32px 37.6px;
    transform: scaleX(calc(1 + var(--spread, 0) * 0.036));
    transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @media (prefers-reduced-motion: reduce) {
    .leg-left,
    .leg-right,
    .arc {
      transition: none;
    }
  }
</style>
