---
interface Props {
  /** Section number, shown with two digits: 1 becomes "01". */
  index: number;
  /** Section name after the number, e.g. "Core Engineering Focus". */
  label: string;
  title: string;
  /** Intro paragraph under the title; paragraphs in the default slot follow it. */
  intro?: string;
  /** id of the <h2>, for the section's aria-labelledby. */
  id?: string;
  /** start: aligned left; center: centred, with the intro narrowed to 52ch. */
  align?: "start" | "center";
}

const { index, label, title, intro, id, align = "start" } = Astro.props;
const number = String(index).padStart(2, "0");
---

<header class:list={["section-header", align]}>
  <p class="label">
    {number} — {label}
  </p>
  <h2 id={id}>{title}</h2>
  {(intro || Astro.slots.has("default")) && (
    <div class="intro">
      {intro && <p>{intro}</p>}
      <slot />
    </div>
  )}
</header>

<style>
  .section-header {
    max-width: 47.5rem;
    margin-bottom: 3.625rem;
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent-cyan);
  }

  .label::before {
    content: "";
    width: 1.625rem;
    height: 1px;
    background: linear-gradient(90deg, var(--color-accent-cyan), transparent);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: clamp(1.9rem, 4.2vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--color-ink);
  }

  .intro {
    max-width: 60ch;
    font-size: 1.02rem;
    color: var(--color-ink-muted);
  }

  .intro :global(p + p) {
    margin-top: 1rem;
  }

  .center {
    margin-inline: auto;
    margin-bottom: 2.125rem;
    text-align: center;
  }

  .center .intro {
    max-width: 52ch;
    margin-inline: auto;
  }
</style>
