---
/*
 * A link port: a spun steel cap set into its panel, the disc carrying the
 * link's engraved icon, then the label. An https: link opens in a new tab
 * and says so to assistive technology (site.json's newTab); `download`
 * saves the linked file under that name.
 */
import { site } from "../../data/index";
import type { LinkItem } from "../../data/types";
import Icon from "./Icon.astro";

interface Props {
  link: LinkItem;
  /** File name to save the linked file under, for a file in public/. */
  download?: string;
}

const { link, download } = Astro.props;
const external = link.url.startsWith("https:");
---

<a
  class="port"
  href={link.url}
  download={download}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
>
  <span class="port-cap" aria-hidden="true">
    <span class="port-disc spun">
      <Icon name={link.icon} size={16} class="engraved-icon" />
    </span>
  </span>
  <span class="port-label">{link.title}</span>
  {external && <span class="sr-only"> {site.newTab}</span>}
</a>

<style>
  /*
   * Hovering or focusing a port lights its icon in --accent-line (gold on
   * the dark theme, bronze on the light one) and underlines the label in
   * gold.
   */
  .port {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--body);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.3s var(--ease-soft);
  }

  .port:hover {
    color: var(--text);
  }

  .port:focus-visible {
    border-radius: 6px;
    outline: 2px solid var(--gold-text);
    outline-offset: 3px;
  }

  .port-cap {
    position: relative;
    display: grid;
    flex: none;
    width: 28px;
    height: 28px;
    overflow: hidden;
    border-radius: 50%;
    box-shadow:
      0 0 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 1px) 1px 0 0 #8a9098,
      calc(var(--lean) * var(--slant) * 2px) 2px 0 0 #6c727a,
      calc(var(--lean) * var(--slant) * 2px) 2px 0 1px var(--metal-outline),
      calc(var(--lean) * var(--slant) * 5px) 5px 6px -1px rgb(0 0 0 / 0.45);
  }

  .port-cap::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.45),
      inset calc(var(--lean) * var(--slant) * 2px) 2px 2px
        rgb(255 255 255 / 0.3),
      inset calc(var(--lean) * var(--slant) * -2px) -2px 4px rgb(0 0 0 / 0.3);
  }

  .port-disc {
    display: grid;
    place-items: center;
    color: #1b1e23;
  }

  .port-disc :global(svg) {
    transition: color 0.3s var(--ease-soft);
  }

  .port:is(:hover, :focus-visible) .port-disc :global(svg) {
    color: var(--accent-line);
  }

  .port-label {
    text-decoration: underline transparent 1px;
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.3s var(--ease-soft);
  }

  .port:hover .port-label {
    text-decoration-color: var(--gold-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .port,
    .port-label,
    .port-disc :global(svg) {
      transition: none;
    }
  }
</style>
