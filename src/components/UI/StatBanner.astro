---
import { stats as allStats } from "../../data/index";
import type { StatItem } from "../../data/types";
import StatCard from "./StatCard.astro";

interface Props {
  /** Stats to show; defaults to every stats.json entry. */
  stats?: StatItem[];
  class?: string;
}

const { stats = allStats, class: className } = Astro.props;
---

<dl class:list={["stats", className]} style={`--stat-count: ${stats.length}`}>
  {stats.map((stat) => (
    <StatCard stat={stat} />
  ))}
</dl>

<style>
  .stats {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-line);
  }

  /* --breakpoint-xs: two columns; an odd last stat spans both. */
  @media (width >= 26.25rem) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stats > :global(:last-child:nth-child(odd)) {
      grid-column: span 2;
    }
  }

  /* --breakpoint-md: one column per stat */
  @media (width >= 47.5rem) {
    .stats {
      grid-template-columns: repeat(var(--stat-count), minmax(0, 1fr));
    }

    .stats > :global(:last-child:nth-child(odd)) {
      grid-column: auto;
    }
  }
</style>
