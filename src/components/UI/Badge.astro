---
interface Props {
  /** tag: small outlined label; chip: tool label; status: pill with a pulsing success dot. */
  variant?: "tag" | "chip" | "status";
  class?: string;
}

const { variant = "tag", class: className } = Astro.props;
---

<span class:list={["badge", variant, className]}>
  {variant === "status" && <span class="dot" aria-hidden="true" />}
  <slot />
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
  }

  .tag {
    padding: 0.1875rem 0.5625rem;
    border: 1px solid var(--color-line);
    border-radius: 0.375rem;
    font-size: 0.6875rem;
    color: var(--color-ink-faint);
    transition:
      color 0.25s,
      border-color 0.25s;
  }

  .chip {
    padding: 0.5rem 0.875rem;
    border: 1px solid var(--color-line);
    border-radius: 0.5625rem;
    background: color-mix(in srgb, var(--color-ink) 2%, transparent);
    font-size: 0.75rem;
    color: var(--color-ink-muted);
    transition:
      color 0.25s,
      border-color 0.25s,
      transform 0.25s var(--ease-soft),
      background-color 0.25s;
  }

  .chip:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent-cyan) 40%, transparent);
    background: color-mix(in srgb, var(--color-accent-cyan) 6%, transparent);
    color: var(--color-ink);
  }

  .status {
    gap: 0.5625rem;
    padding: 0.4375rem 0.9375rem 0.4375rem 0.75rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 99px;
    background: color-mix(in srgb, var(--color-ink) 3%, transparent);
    font-size: 0.78125rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink-muted);
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    animation: var(--animate-status-ping);
  }
</style>
