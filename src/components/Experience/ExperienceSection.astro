---
/*
 * The experience section from experience.json: an ExperienceItem per role,
 * most recent first, along a vertical timeline rail.
 */
import { experience } from "../../data/index";
import Section from "../UI/Section.astro";
import ExperienceItem from "./ExperienceItem.astro";
---

<Section
  id={experience.id}
  label={experience.label}
  title={experience.headline}
>
  <div class="timeline">
    {experience.roles.map((item) => (
      <ExperienceItem item={item} ongoing={experience.ongoing} />
    ))}
  </div>
</Section>

<style>
  /* --rail is the timeline's left padding, where each ExperienceItem draws its dot. */
  .timeline {
    --rail: 1.625rem;
    position: relative;
    padding-left: var(--rail);
  }

  /* The rail: a line through the dots' centres, fading out down the timeline. */
  .timeline::before {
    content: "";
    position: absolute;
    top: 8px;
    bottom: 8px;
    left: 7px;
    width: 1px;
    background: linear-gradient(
      180deg,
      var(--color-accent-cyan),
      color-mix(in srgb, var(--color-accent-violet) 35%, transparent) 45%,
      transparent
    );
  }

  /* --breakpoint-md */
  @media (width >= 47.5rem) {
    .timeline {
      --rail: 2.125rem;
    }
  }
</style>
